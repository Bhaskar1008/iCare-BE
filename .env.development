PORT=3000
MONGODB_URI=mongodb://localhost:27017/icare_dev
APP_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_jwt_secret_dev
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_dev
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=iCare <noreply@icare.com>

# SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM=iCare

# Security Configuration
API_KEY=your_api_key_here
BLACKLISTED_IPS=
RATE_LIMIT_MAX=100
BCRYPT_SALT_ROUNDS=12

# Kafka Configuration
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=icare-service
KAFKA_GROUP_ID=icare-group

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_URL=https://your-bucket-name.s3.ap-southeast-1.amazonaws.com

# Logging
LOG_LEVEL=debug